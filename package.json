{
  "name": "ludo-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json && node scripts/build-service-worker.mjs",
    "start": "node build/server/index.js --production",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "test:load": "tsx scripts/load-smoke.ts",
    "format": "prettier --write src server shared tests scripts *.ts *.json docs README.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "motion": "^12.23.24",
    "proxy-addr": "^2.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
